{
    "name": "podlom/evernote-importer",
    "description": "A PHP library to import Evernote ENEX exports",
    "type": "library",
    "license": "MIT",

    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-simplexml": "*"
    },

    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },

    "autoload": {
        "psr-4": {
            "Podlom\\EvernoteImporter\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Podlom\\EvernoteImporter\\Tests\\": "tests/"
        }
    }
}
